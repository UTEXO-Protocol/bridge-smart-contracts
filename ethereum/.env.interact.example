# =============================================================================
# Environment for interaction scripts (script/interact/)
#
# Usage:
#   cp .env.interact.example .env.interact
#   # fill in values for the call you want to make, then load before running:
#   set -a && source .env.interact && set +a
#   forge script script/interact/BridgeFundsIn.s.sol --rpc-url $RPC_URL --broadcast
# =============================================================================

# -----------------------------------------------------------------------------
# Common (shared with deploy .env)
# -----------------------------------------------------------------------------

# Caller private key (the EOA that submits the tx; for fundsIn this is the user,
# for MultisigExecuteFundsOut this is just the relayer, and for GuardianEmergency*
# it must be the configured guardian — TEE/federation signing keys live below).
PRIVATE_KEY=

# RPC endpoint for the target network
RPC_URL=

# -----------------------------------------------------------------------------
# Deployed contract addresses
# -----------------------------------------------------------------------------

BRIDGE_ADDRESS=
PROXY_ADDRESS=
MINIMAL_BRIDGE_ADDRESS=

# -----------------------------------------------------------------------------
# fundsIn parameters (BridgeFundsIn.s.sol)
# -----------------------------------------------------------------------------

# Token base units (wei for 18-decimal tokens; for 6-decimal USDT0 → 1 USDT = 1_000_000)
AMOUNT=

# RGB correlation OpId carried in fundsIn settlementData. The canonical Bridge
# operationId is derived on-chain and printed by BridgeFundsIn.s.sol.
RGB_OP_ID=

# Destination chain id (uint256). EVM legs = real chain id; non-EVM endpoints
# use backend-assigned ids in a reserved namespace above 2^32 (RGB = 1000001).
DESTINATION_CHAIN_ID=1000001
DESTINATION_ADDRESS=

# -----------------------------------------------------------------------------
# fundsOut parameters (MultisigExecuteFundsOut.s.sol)
# -----------------------------------------------------------------------------

RECIPIENT=
SOURCE_CHAIN_ID=1000001
# Must be empty for RGB; other routes define their own canonical form.
SOURCE_ADDRESS=

# Unique source-chain burn transaction id. For RGB this is the burn transition
# OpId. MultisigExecuteFundsOut derives the Bridge burnId from this value and
# the other canonical settlement fields.
SOURCE_BURN_TX_ID=

# RGBVerifier proof inputs. The source pair identifies the Bitcoin block that
# contains the RGB burn; the latest pair anchors relay freshness.
SOURCE_BLOCK_HEIGHT=
SOURCE_COMMITMENT_HASH=
LATEST_BLOCK_HEIGHT=
LATEST_COMMITMENT_HASH=

# RgbSettlementModule settlementData inputs — comma-separated list of fundsIn
# operationIds the fundsOut verifies, plus exact parallel amounts. Packed as
# abi.encode(bytes32[], uint256[]) by the script. Other settlement modules use
# different blob layouts.
FUNDS_IN_IDS=
FUNDS_IN_AMOUNTS=

# -----------------------------------------------------------------------------
# MultisigProposeSetRoute parameters
# -----------------------------------------------------------------------------

# The (source, dest) pair the route key — same uint256 chain-id convention as above.
# Reuses SOURCE_CHAIN_ID / DESTINATION_CHAIN_ID; just set ROUTE_ENABLED + plugin
# addresses below.
ROUTE_ENABLED=true
FINALITY_VERIFIER=
SETTLEMENT_MODULE=

# Replacement guardian for MultisigProposeSetEmergencyGuardian.s.sol.
# address(0) intentionally disables the direct guardian path.
NEW_EMERGENCY_GUARDIAN=

# Bridge upgrade / governance migration inputs.
NEW_BRIDGE_IMPLEMENTATION=
UPGRADE_CALLDATA=0x

# -----------------------------------------------------------------------------
# Multisig signing (TEE / Federation simulation for testnet)
# -----------------------------------------------------------------------------

# Comma-separated private keys (hex) — ordered by signer bit index.
# In production, TEE enclaves produce these signatures; this is for local sims.
ENCLAVE_PKS=
FED_PKS=

# Bitmap of participating signers (e.g. 0x3 for signers 0 and 1).
ENCLAVE_BITMAP=0x3
FED_BITMAP=0x3

# How far ahead (seconds) to set the signed deadline.
DEADLINE_OFFSET=3600
