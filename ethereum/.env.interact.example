# Interaction inputs. Run from ethereum/:
#   cp .env.interact.example .env.interact
#   set -a; source .env.interact; set +a
#   forge script script/interact/BridgeFundsIn.s.sol --rpc-url "$RPC_URL" --broadcast
# Set inputs for the chosen operation; the same chain fields serve different scripts.

# Transaction sender. For guardian pause this must be the configured guardian.
PRIVATE_KEY=
RPC_URL=
BRIDGE_ADDRESS=
PROXY_ADDRESS=

# RGB deposit: amount in token smallest units (1 USDT0 = 1000000), mint OpId and network.
AMOUNT=
RGB_OP_ID=
DESTINATION_CHAIN_ID=827166
# Empty for RGB: the destination address is carried in the consignment.
DESTINATION_ADDRESS=

# RGB release: set DESTINATION_CHAIN_ID=42161 for release on Arbitrum One.
RECIPIENT=
SOURCE_CHAIN_ID=827166
# RGBVerifier requires this separate sourceAddress field to be empty.
SOURCE_ADDRESS=
# Unique source-burn identifier; RGB uses the burn transition OpId.
SOURCE_BURN_TX_ID=

# RGB proof: source and latest Bitcoin block heights and relay commitments.
SOURCE_BLOCK_HEIGHT=
SOURCE_COMMITMENT_HASH=
LATEST_BLOCK_HEIGHT=
LATEST_COMMITMENT_HASH=

# Parallel comma-separated RGB backing record ids and exact recorded amounts.
# MultisigExecuteFundsOut encodes these as abi.encode(bytes32[], uint256[]).
FUNDS_IN_IDS=
FUNDS_IN_AMOUNTS=

# MultisigProposeSetRoute uses SOURCE_CHAIN_ID and DEST_CHAIN_ID (not DESTINATION_CHAIN_ID).
# Example: RGB -> Arbitrum. Reverse the ids to configure deposits.
DEST_CHAIN_ID=42161
ROUTE_ENABLED=true
FINALITY_VERIFIER=
SETTLEMENT_MODULE=

# Guardian replacement; the full zero address disables direct guardian access.
NEW_EMERGENCY_GUARDIAN=

# Bridge implementation upgrade. Use 0x when no reinitializer is needed.
# Nonempty calldata must include a selector and be no longer than 4096 bytes.
NEW_BRIDGE_IMPLEMENTATION=
UPGRADE_CALLDATA=0x

# Local/testnet signing only. Production signatures come from enclave and federation signers.
# Keys are comma-separated, ordered by signer bitmap index.
ENCLAVE_PKS=
FED_PKS=
# 0x3 selects signers 0 and 1.
ENCLAVE_BITMAP=0x3
FED_BITMAP=0x3
# Seconds until signature deadline. Proposals must cover the timelock plus an execution window;
# TEE and emergency submissions permit at most 86400 seconds.
DEADLINE_OFFSET=86400
