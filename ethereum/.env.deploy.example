# Deployment inputs. Run from ethereum/:
#   cp .env.deploy.example .env.deploy
#   set -a; source .env.deploy; set +a
#   forge script script/deploy/DeployAll.s.sol --rpc-url "$RPC_URL" --broadcast --verify
# Fill blank values required by the selected script. Never commit private keys.

# Transaction sender and target EVM network.
PRIVATE_KEY=
RPC_URL=
ETHERSCAN_API_KEY=

# Bridge/MinimalBridge accepted token and deployed Bitcoin header relay.
USDT0_ADDRESS=
BTC_RELAY_ADDRESS=

# Optional initial adapter for DeployBridge. DeployAll leaves adapter wiring to governance.
LZ_ADAPTER=0x0000000000000000000000000000000000000000

# Amount floors in token smallest units (USDT0 has 6 decimals).
# Both must be positive; MIN_FUNDS_IN_AMOUNT >= MIN_FUNDS_OUT_AMOUNT.
# At MIN_FUNDS_OUT_AMOUNT the combined proportional + baseFee must leave positive
# token net. Choose the floor above settlement costs and validate release fee rules.
MIN_FUNDS_IN_AMOUNT=
MIN_FUNDS_OUT_AMOUNT=

# Initial enclave source network: RGB = 827166; Arbitrum One = 42161.
INITIAL_ENCLAVE_SOURCE_CHAIN_ID=827166

# Outflow policy in basis points. Each burst + full-window refill must be <= 2000.
# These examples allocate 10% burst and 10% refill per 24-hour window.
INITIAL_CHAIN_BURST_BPS=1000
INITIAL_CHAIN_REFILL_BPS_PER_WINDOW=1000
GLOBAL_BURST_BPS=1000
GLOBAL_REFILL_BPS_PER_WINDOW=1000

# RGB verifier confirmation thresholds (deployment defaults).
# Thresholds are fixed in each verifier deployment.
MIN_SOURCE_CONFIRMATIONS=3
MAX_LATEST_CONFIRMATIONS=2
MIN_CONFIRMATION_GAP=2

# Step-by-step deployments only; DeployAll creates CM and registry itself.
# Both must be bound to the Bridge proxy address, not its implementation.
COMMISSION_MANAGER=
ROUTE_REGISTRY_ADDRESS=
BRIDGE_ADDRESS=
# DeployRouteRegistry initial owner. DeployAll initially uses the deployer.
OWNER_ADDRESS=

# CM withdrawal destination, fixed for the lifetime of that CM.
COMMISSION_RECIPIENT=

# Optional NATIVE fee quoting. Set the feed, heartbeat, sequencer and both price
# bounds together. Leave ETH_USD_FEED empty to configure the oracle later.
# Arbitrum One ETH/USD: 0x639Fe6ab55C921f74e7fac1ee960C0B6293ba612
# Reference: https://data.chain.link/feeds/arbitrum/mainnet/eth-usd
# Verify network-specific feed addresses before deployment.
ETH_USD_FEED=
# Maximum accepted price age in seconds; choose from the feed's published heartbeat.
ETH_USD_HEARTBEAT=87000
# Arbitrum One sequencer feed: 0xFdB631F5EE196F0ed6FAa767959853A9F217697D
# Reference: https://docs.chain.link/data-feeds/l2-sequencer-feeds
# Quotes reject downtime and the 3600-second post-restart grace period.
SEQUENCER_UPTIME_FEED=
# Positive ordered ETH/USD bounds in feed units; e.g. $100 is 10000000000 at 8 decimals.
ETH_USD_MIN_PRICE=
ETH_USD_MAX_PRICE=

# Signer addresses in bitmap-index order. Each set needs at least two signers
# and a strict-majority threshold. Federation and enclave addresses must be disjoint.
ENCLAVE_SIGNERS=
FEDERATION_SIGNERS=
ENCLAVE_THRESHOLD=2
FEDERATION_THRESHOLD=2

# Nonzero initial guardian; can pause without signatures. Only federation can unpause.
EMERGENCY_GUARDIAN=
# Federation proposal delay and its immutable lower bound, in seconds.
# 0 < MIN_TIMELOCK <= TIMELOCK_DURATION < 30 days.
TIMELOCK_DURATION=3600
MIN_TIMELOCK=3600

# Standalone DeployRgbRejectList only. The script requires different addresses.
# Use a cold owner key and a hot appender key. The owner rotates the appender;
# only the appender publishes decisions.
REJECT_LIST_OWNER=
REJECT_LIST_APPENDER=

# Standalone DeployBtcRelay only. Supply an independently checked, deep checkpoint.
# Allow a substantial reorg margin (e.g. ~144 blocks); this is operational guidance,
# not an enforced minimum or finality guarantee. A reorg below it requires replacement.
# 160-byte stored header: raw header (80), chainwork (32), height (4),
# last difficulty adjustment (4), and ten previous timestamps (40).
BTC_CHECKPOINT_HEADER=
BTC_CHECKPOINT_HEIGHT=
# Block hash in explorer/display order; chainwork as a 32-byte hex value.
BTC_CHECKPOINT_BLOCKHASH=
BTC_CHECKPOINT_CHAINWORK=
BTC_CLAMP_BLOCK_TARGET=true
BTC_RELAY_TESTNET=false
